<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    PrintQueueView.fxml
    Production Print Queue & Machine Workshop Management Screen
    Controller: com.dcroyal.controller.PrintQueueController
-->
<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.dcroyal.controller.PrintQueueController"
    style="-fx-background-color: #F6F3EC;">

    <!-- Left Sidebar -->
    <left>
        <fx:include source="Sidebar.fxml" fx:id="sidebar"/>
    </left>

    <!-- Main Content Area -->
    <center>
        <BorderPane style="-fx-background-color: #F6F3EC;">

            <!-- Top Header -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-padding: 24 32 16 32; -fx-background-color: #F6F3EC;">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="PRODUCTION &amp; PRINTING"
                               style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #62656F; -fx-letter-spacing: 1px;"/>
                        <Label text="Print Queue &amp; Workshop Status"
                               style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                    </VBox>

                    <!-- Search Bar in Top Bar -->
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <TextField fx:id="searchField"
                                   promptText="🔍  Search by order #, customer or item..."
                                   prefWidth="320" prefHeight="40"
                                   style="
                                       -fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-border-color: #E6E0D3;
                                       -fx-border-radius: 10;
                                       -fx-border-width: 1;
                                       -fx-padding: 0 14;
                                       -fx-font-size: 13px;"/>
                    </HBox>
                </HBox>
            </top>

            <!-- Center Content (KPIs on Top, Table & Actions Below) -->
            <center>
                <VBox spacing="16" style="-fx-padding: 0 32 32 32; -fx-background-color: #F6F3EC;">

                    <!-- ROW 1: 4 KPI CARDS -->
                    <HBox spacing="16">

                        <!-- KPI 1: In Queue -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                            <Label text="In Print Queue" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="inQueueCountLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #F5B800;"/>
                            <Label text="Waiting for operator" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #07768F;"/>
                        </VBox>

                        <!-- KPI 2: Currently Printing -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                            <Label text="Currently Printing" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="printingCountLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #07768F;"/>
                            <Label text="Active machine jobs" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #1A7A46;"/>
                        </VBox>

                        <!-- KPI 3: Completed Today -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                            <Label text="Printed Done Today" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="completedTodayCountLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #1A7A46;"/>
                            <Label text="Sent to packing" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #1A7A46;"/>
                        </VBox>

                        <!-- KPI 4: Assigned To Me -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 1);">
                            <Label text="Assigned to Me" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="assignedToMeCountLabel" text="0" style="-fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #14161F;"/>
                            <Label text="My current jobs" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #07768F;"/>
                        </VBox>

                    </HBox>

                    <!-- ROW 2: QUEUE TABLE (LEFT) & ACTION PANEL (RIGHT) -->
                    <HBox spacing="16" VBox.vgrow="ALWAYS">

                        <!-- LEFT: QUEUE TABLE -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 16;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 16;
                                  -fx-border-width: 1;
                                  -fx-padding: 18;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 1);">

                            <!-- Filters Row -->
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="Queue Status:" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                                <ComboBox fx:id="statusFilterComboBox" prefWidth="160" prefHeight="34"
                                          style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>

                                <Label text="Technology:" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-padding: 0 0 0 10;"/>
                                <ComboBox fx:id="categoryFilterComboBox" prefWidth="160" prefHeight="34"
                                          style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <Button text="🔄  Refresh" onAction="#handleRefresh" prefHeight="34"
                                        style="-fx-background-color: #EBE7DF; -fx-text-fill: #15171F; -fx-font-weight: 600; -fx-background-radius: 6; -fx-cursor: hand;"/>
                            </HBox>

                            <Separator style="-fx-padding: 2 0;"/>

                            <!-- Queue TableView -->
                            <TableView fx:id="queueTable" VBox.vgrow="ALWAYS" prefHeight="380"
                                       style="-fx-background-color: transparent; -fx-border-color: #E6E0D3; -fx-border-radius: 8;">
                                <columns>
                                    <TableColumn fx:id="colOrderNumber" text="Order #" prefWidth="110"/>
                                    <TableColumn fx:id="colCustomer" text="Customer" prefWidth="140"/>
                                    <TableColumn fx:id="colPrintType" text="Print Type" prefWidth="110"/>
                                    <TableColumn fx:id="colItemName" text="Item Name" prefWidth="150"/>
                                    <TableColumn fx:id="colMaterial" text="Material" prefWidth="100"/>
                                    <TableColumn fx:id="colQty" text="Qty" prefWidth="50"/>
                                    <TableColumn fx:id="colSpecs" text="Specifications" prefWidth="140"/>
                                    <TableColumn fx:id="colOperator" text="Operator" prefWidth="110"/>
                                    <TableColumn fx:id="colStatus" text="Queue Status" prefWidth="120"/>
                                    <TableColumn fx:id="colDueDate" text="Due Date" prefWidth="95"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>

                        </VBox>

                        <!-- RIGHT: WORKSHOP ACTION CARD -->
                        <VBox spacing="16" prefWidth="320" minWidth="300"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 16;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 16;
                                  -fx-border-width: 1;
                                  -fx-padding: 20;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 1);">

                            <VBox spacing="2">
                                <Label text="Workshop Job Action"
                                       style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                                <Label text="Select a job from the queue to start or finish"
                                       style="-fx-font-size: 12px; -fx-text-fill: #62656F;"/>
                            </VBox>

                            <Separator style="-fx-padding: 2 0;"/>

                            <!-- Selected Job Info Box -->
                            <VBox spacing="8"
                                  style="-fx-background-color: #F6F3EC; -fx-background-radius: 10; -fx-padding: 14;">
                                <Label text="SELECTED JOB"
                                       style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #9DA1B0; -fx-letter-spacing: 1px;"/>
                                <Label fx:id="selectedOrderLabel" text="No order selected" wrapText="true"
                                       style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                                <Label fx:id="selectedCustomerLabel" text="-" style="-fx-font-size: 12px; -fx-text-fill: #62656F;"/>
                                <Label fx:id="selectedStatusLabel" text="-" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #07768F;"/>
                                <Label fx:id="selectedDueLabel" text="-" style="-fx-font-size: 12px; -fx-text-fill: #62656F;"/>
                            </VBox>

                            <!-- Step 1: Start Printing -->
                            <VBox spacing="6">
                                <Label text="Step 1: Machine Setup &amp; Start" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <Button fx:id="startPrintingButton" text="▶   Start Printing" disable="true"
                                        maxWidth="Infinity" prefHeight="44"
                                        onAction="#handleStartPrinting"
                                        style="
                                            -fx-background-color: #07768F;
                                            -fx-text-fill: white;
                                            -fx-font-weight: 700;
                                            -fx-font-size: 14px;
                                            -fx-background-radius: 10;
                                            -fx-cursor: hand;"/>
                            </VBox>

                            <!-- Step 2: Finish & Send to Packing -->
                            <VBox spacing="6">
                                <Label text="Step 2: Manual Print Complete" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <Button fx:id="finishPrintingButton" text="✔   Finish &amp; Send to Packing" disable="true"
                                        maxWidth="Infinity" prefHeight="44"
                                        onAction="#handleFinishPrinting"
                                        style="
                                            -fx-background-color: #1A7A46;
                                            -fx-text-fill: white;
                                            -fx-font-weight: 700;
                                            -fx-font-size: 14px;
                                            -fx-background-radius: 10;
                                            -fx-cursor: hand;"/>
                            </VBox>

                            <Separator style="-fx-padding: 4 0;"/>

                            <!-- Info Note -->
                            <VBox spacing="4"
                                  style="-fx-background-color: #FFF9E6; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #FFE6A0; -fx-border-radius: 8;">
                                <Label text="💡 Note for Operators:" style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #856404;"/>
                                <Label text="After clicking Finish, the order moves to Packing and triggers automatic SMS notification to the customer." wrapText="true"
                                       style="-fx-font-size: 11px; -fx-text-fill: #856404;"/>
                            </VBox>

                        </VBox>

                    </HBox>

                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>
