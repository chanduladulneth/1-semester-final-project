<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    DeliveryView.fxml
    Island-wide Delivery Management, Dispatch Tracking, and Route Sheet Generation Screen
    Controller: com.dcroyal.controller.DeliveryController
-->
<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.dcroyal.controller.DeliveryController"
    style="-fx-background-color: #F6F3EC;">

    <!-- Left Sidebar -->
    <left>
        <fx:include source="Sidebar.fxml" fx:id="sidebar"/>
    </left>

    <!-- Main Content Area -->
    <center>
        <BorderPane style="-fx-background-color: #F6F3EC;">

            <!-- Top Header -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-padding: 22 32 10 32; -fx-background-color: #F6F3EC;">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="ISLAND-WIDE LOGISTICS"
                               style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #62656F; -fx-letter-spacing: 1px;"/>
                        <Label text="Delivery Management &amp; Driver Routing"
                               style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                    </VBox>

                    <Button text="🔄  Refresh" onAction="#handleRefresh" prefHeight="36"
                            style="-fx-background-color: #EBE7DF; -fx-text-fill: #15171F; -fx-font-weight: 600; -fx-background-radius: 8; -fx-cursor: hand;"/>
                </HBox>
            </top>

            <!-- Center Content -->
            <center>
                <VBox spacing="14" style="-fx-padding: 0 32 24 32; -fx-background-color: #F6F3EC;">

                    <!-- ROW 1: 4 KPI CARDS -->
                    <HBox spacing="16">

                        <!-- KPI 1: Scheduled Today -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 14 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 6, 0, 0, 1);">
                            <Label text="Deliveries Scheduled Today" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="scheduledTodayCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #07768F;"/>
                            <Label text="On today's delivery manifest" style="-fx-font-size: 11px; -fx-text-fill: #62656F;"/>
                        </VBox>

                        <!-- KPI 2: In Transit -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 14 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 6, 0, 0, 1);">
                            <Label text="Currently In Transit" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="inTransitCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #F5B800;"/>
                            <Label text="Out on delivery vehicle" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #07768F;"/>
                        </VBox>

                        <!-- KPI 3: Delivered Today -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 14 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 6, 0, 0, 1);">
                            <Label text="Delivered Done Today" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="deliveredTodayCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #1A7A46;"/>
                            <Label text="Successfully handed to client" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #1A7A46;"/>
                        </VBox>

                        <!-- KPI 4: Failed / Retry -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 14;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 14;
                                  -fx-border-width: 1;
                                  -fx-padding: 14 16;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 6, 0, 0, 1);">
                            <Label text="Failed / Need Retry" style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-font-weight: 600;"/>
                            <Label fx:id="failedCountLabel" text="0" style="-fx-font-size: 24px; -fx-font-weight: 700; -fx-text-fill: #B8134F;"/>
                            <Label text="Address / customer issue" style="-fx-font-size: 11px; -fx-text-fill: #B8134F;"/>
                        </VBox>

                    </HBox>

                    <!-- ROW 2: TABPANE -->
                    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                             style="-fx-background-color: transparent;">

                        <!-- ============================================== -->
                        <!-- TAB 1: ACTIVE DELIVERIES & DISPATCH           -->
                        <!-- ============================================== -->
                        <Tab text="🚚  Active Deliveries &amp; Route Dispatch">
                            <HBox spacing="16" style="-fx-padding: 14 0 0 0;">

                                <!-- LEFT: DELIVERIES TABLE -->
                                <VBox spacing="12" HBox.hgrow="ALWAYS"
                                      style="
                                          -fx-background-color: white;
                                          -fx-background-radius: 14;
                                          -fx-border-color: #E6E0D3;
                                          -fx-border-radius: 14;
                                          -fx-border-width: 1;
                                          -fx-padding: 18;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 6, 0, 0, 1);">

                                    <!-- Table Filters -->
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="Filter Status:" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                                        <ComboBox fx:id="statusFilterComboBox" prefWidth="150" prefHeight="34"
                                                  style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <TextField fx:id="searchField" promptText="🔍  Search by order #, recipient, address or driver..."
                                                   prefWidth="320" prefHeight="34"
                                                   style="-fx-border-color: #E6E0D3; -fx-border-radius: 6; -fx-padding: 0 10;"/>
                                    </HBox>

                                    <Separator style="-fx-padding: 2 0;"/>

                                    <TableView fx:id="deliveryTable" VBox.vgrow="ALWAYS" prefHeight="380"
                                               style="-fx-background-color: transparent; -fx-border-color: #E6E0D3; -fx-border-radius: 8;">
                                        <columns>
                                            <TableColumn fx:id="colOrderNumber" text="Order #" prefWidth="110"/>
                                            <TableColumn fx:id="colRecipient" text="Recipient" prefWidth="130"/>
                                            <TableColumn fx:id="colPhone" text="Phone" prefWidth="105"/>
                                            <TableColumn fx:id="colAddress" text="Delivery Address" prefWidth="200"/>
                                            <TableColumn fx:id="colDate" text="Date" prefWidth="90"/>
                                            <TableColumn fx:id="colDriver" text="Assigned Driver" prefWidth="120"/>
                                            <TableColumn fx:id="colStatus" text="Delivery Status" prefWidth="110"/>
                                            <TableColumn fx:id="colDeliveredTime" text="Delivered At" prefWidth="120"/>
                                            <TableColumn fx:id="colNotes" text="Notes" prefWidth="120"/>
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                        </columnResizePolicy>
                                    </TableView>

                                </VBox>

                                <!-- RIGHT: DRIVER ACTION PANEL -->
                                <VBox spacing="14" prefWidth="350" minWidth="320"
                                      style="
                                          -fx-background-color: white;
                                          -fx-background-radius: 14;
                                          -fx-border-color: #E6E0D3;
                                          -fx-border-radius: 14;
                                          -fx-border-width: 1;
                                          -fx-padding: 18;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 6, 0, 0, 1);">

                                    <Label text="Driver Dispatch Actions"
                                           style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>

                                    <!-- Selected Delivery Info -->
                                    <VBox spacing="6"
                                          style="-fx-background-color: #F6F3EC; -fx-background-radius: 10; -fx-padding: 12;">
                                        <Label text="SELECTED DELIVERY PARCEL"
                                               style="-fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #9DA1B0; -fx-letter-spacing: 1px;"/>
                                        <Label fx:id="selectedOrderLabel" text="No delivery selected"
                                               style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                                        <Label fx:id="selectedRecipientLabel" text="-" wrapText="true"
                                               style="-fx-font-size: 12px; -fx-text-fill: #62656F;"/>
                                        <Label fx:id="selectedAddressLabel" text="-" wrapText="true"
                                               style="-fx-font-size: 11px; -fx-text-fill: #07768F; -fx-font-weight: 600;"/>
                                        <Label fx:id="selectedDriverLabel" text="-" wrapText="true"
                                               style="-fx-font-size: 11px; -fx-text-fill: #15171F;"/>
                                    </VBox>

                                    <!-- Action 1: Dispatch / In Transit -->
                                    <VBox spacing="4">
                                        <Label text="1. Dispatch On Vehicle" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                                        <Button fx:id="dispatchButton" text="🚚   Dispatch / In Transit" disable="true"
                                                maxWidth="Infinity" prefHeight="40"
                                                onAction="#handleDispatch"
                                                style="
                                                    -fx-background-color: #07768F;
                                                    -fx-text-fill: white;
                                                    -fx-font-weight: 700;
                                                    -fx-font-size: 13px;
                                                    -fx-background-radius: 8;
                                                    -fx-cursor: hand;"/>
                                    </VBox>

                                    <!-- Action 2: Mark Delivered -->
                                    <VBox spacing="4">
                                        <Label text="2. Handover Complete" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                                        <Button fx:id="deliverButton" text="✔   Mark Delivered &amp; Auto-SMS" disable="true"
                                                maxWidth="Infinity" prefHeight="40"
                                                onAction="#handleMarkDelivered"
                                                style="
                                                    -fx-background-color: #1A7A46;
                                                    -fx-text-fill: white;
                                                    -fx-font-weight: 700;
                                                    -fx-font-size: 13px;
                                                    -fx-background-radius: 8;
                                                    -fx-cursor: hand;"/>
                                    </VBox>

                                    <!-- Action 3: Failed / Retry -->
                                    <Button fx:id="failButton" text="❌   Mark Delivery Failed / Retry" disable="true"
                                            maxWidth="Infinity" prefHeight="32"
                                            onAction="#handleMarkFailed"
                                            style="
                                                -fx-background-color: #FFF0F4;
                                                -fx-text-fill: #B8134F;
                                                -fx-font-weight: 600;
                                                -fx-border-color: #F8B4C8;
                                                -fx-border-radius: 6;
                                                -fx-background-radius: 6;
                                                -fx-cursor: hand;"/>

                                    <Separator style="-fx-padding: 4 0;"/>

                                    <!-- Action 4: Route Sheet -->
                                    <Button fx:id="printRouteSheetButton" text="📄   Daily Delivery Route Sheet"
                                            maxWidth="Infinity" prefHeight="36"
                                            onAction="#handlePrintRouteSheet"
                                            style="
                                                -fx-background-color: #14161F;
                                                -fx-text-fill: white;
                                                -fx-font-weight: 700;
                                                -fx-background-radius: 8;
                                                -fx-cursor: hand;"/>

                                    <Label text="Dispatch and Delivery triggers automated customer SMS notifications in real time." wrapText="true"
                                           style="-fx-font-size: 11px; -fx-text-fill: #62656F; -fx-text-alignment: center;"/>

                                </VBox>

                            </HBox>
                        </Tab>

                        <!-- ============================================== -->
                        <!-- TAB 2: ASSIGN PACKED ORDERS TO DRIVER          -->
                        <!-- ============================================== -->
                        <Tab text="➕  Assign Orders to Driver">
                            <HBox spacing="16" style="-fx-padding: 14 0 0 0;">

                                <VBox spacing="14" prefWidth="480"
                                      style="
                                          -fx-background-color: white;
                                          -fx-background-radius: 14;
                                          -fx-border-color: #E6E0D3;
                                          -fx-border-radius: 14;
                                          -fx-border-width: 1;
                                          -fx-padding: 22;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 6, 0, 0, 1);">

                                    <Label text="Assign Delivery Order to Driver"
                                           style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                                    <Label text="Assign packed orders requiring island-wide delivery to staff drivers"
                                           style="-fx-font-size: 12px; -fx-text-fill: #62656F;"/>

                                    <Separator style="-fx-padding: 2 0;"/>

                                    <!-- Packed Order ComboBox -->
                                    <VBox spacing="4">
                                        <Label text="Select Packed Order *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                                        <ComboBox fx:id="assignOrderComboBox" promptText="Select order..." maxWidth="Infinity" prefHeight="34"
                                                  style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                                    </VBox>

                                    <!-- Driver ComboBox -->
                                    <VBox spacing="4">
                                        <Label text="Assign Delivery Driver *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                                        <ComboBox fx:id="assignDriverComboBox" promptText="Select driver..." maxWidth="Infinity" prefHeight="34"
                                                  style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                                    </VBox>

                                    <!-- Scheduled Date -->
                                    <VBox spacing="4">
                                        <Label text="Scheduled Delivery Date *" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                                        <DatePicker fx:id="scheduledDatePicker" maxWidth="Infinity" prefHeight="34"/>
                                    </VBox>

                                    <!-- Recipient Name & Phone -->
                                    <HBox spacing="10">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Recipient Name" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                                            <TextField fx:id="recipientNameField" prefHeight="32"
                                                       style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                                        </VBox>
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label text="Recipient Phone" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                                            <TextField fx:id="recipientPhoneField" prefHeight="32"
                                                       style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Delivery Address -->
                                    <VBox spacing="4">
                                        <Label text="Destination Delivery Address" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                                        <TextArea fx:id="deliveryAddressArea" prefRowCount="3" wrapText="true"
                                                  style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                                    </VBox>

                                    <!-- Notes -->
                                    <VBox spacing="4">
                                        <Label text="Special Delivery Notes" style="-fx-font-size: 11px; -fx-font-weight: 600;"/>
                                        <TextField fx:id="assignNotesField" promptText="e.g. Call before delivery, deliver after 2 PM" prefHeight="32"
                                                   style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                                    </VBox>

                                    <!-- Submit Button -->
                                    <Button fx:id="createAssignmentButton" text="➕   Create Delivery Assignment"
                                            maxWidth="Infinity" prefHeight="42"
                                            onAction="#handleCreateAssignment"
                                            style="
                                                -fx-background-color: #07768F;
                                                -fx-text-fill: white;
                                                -fx-font-weight: 700;
                                                -fx-font-size: 13px;
                                                -fx-background-radius: 8;
                                                -fx-cursor: hand;"/>

                                </VBox>

                            </HBox>
                        </Tab>

                    </TabPane>

                </VBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>
