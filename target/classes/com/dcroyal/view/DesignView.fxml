<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    DesignView.fxml
    Customer & In-House Design Management Screen
    Controller: com.dcroyal.controller.DesignController
-->
<BorderPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.dcroyal.controller.DesignController"
    style="-fx-background-color: #F6F3EC;">

    <!-- Left Sidebar -->
    <left>
        <fx:include source="Sidebar.fxml" fx:id="sidebar"/>
    </left>

    <!-- Main Content Area -->
    <center>
        <BorderPane style="-fx-background-color: #F6F3EC;">

            <!-- Top Header -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-padding: 24 32 16 32; -fx-background-color: #F6F3EC;">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="DESIGNS &amp; ARTWORK"
                               style="-fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #62656F; -fx-letter-spacing: 1px;"/>
                        <Label text="Design Management &amp; Approvals"
                               style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                    </VBox>

                    <!-- Search Bar in Top Bar -->
                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <TextField fx:id="searchField"
                                   promptText="🔍  Search by design code, customer or material..."
                                   prefWidth="340" prefHeight="40"
                                   style="
                                       -fx-background-color: white;
                                       -fx-background-radius: 10;
                                       -fx-border-color: #E6E0D3;
                                       -fx-border-radius: 10;
                                       -fx-border-width: 1;
                                       -fx-padding: 0 14;
                                       -fx-font-size: 13px;"/>
                    </HBox>
                </HBox>
            </top>

            <!-- Center Content (Form on Left, Table on Right) -->
            <center>
                <HBox spacing="20"
                      style="-fx-padding: 8 32 32 32; -fx-background-color: #F6F3EC;">

                    <!-- LEFT FORM CARD -->
                    <ScrollPane fitToWidth="true" prefWidth="400" minWidth="360"
                                style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                        <VBox spacing="14"
                              style="
                                  -fx-background-color: white;
                                  -fx-background-radius: 16;
                                  -fx-border-color: #E6E0D3;
                                  -fx-border-radius: 16;
                                  -fx-border-width: 1;
                                  -fx-padding: 20;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 1);">

                            <!-- Form Header -->
                            <VBox spacing="2">
                                <Label text="Design Specifications"
                                       style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                                <Label text="Attach artwork or record in-house design parameters"
                                       style="-fx-font-size: 12px; -fx-text-fill: #62656F;"/>
                            </VBox>

                            <Separator style="-fx-padding: 2 0;"/>

                            <!-- Design Code -->
                            <VBox spacing="4">
                                <Label text="Design Code" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <TextField fx:id="designCodeField" editable="false" prefHeight="34"
                                           style="-fx-background-color: #F1EFEA; -fx-font-weight: 700; -fx-text-fill: #07768F; -fx-border-color: #E6E0D3; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>

                            <!-- Customer Picker -->
                            <VBox spacing="4">
                                <Label text="Customer *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <ComboBox fx:id="customerComboBox" promptText="Select customer..." maxWidth="Infinity" prefHeight="34"
                                          style="-fx-background-color: white; -fx-border-color: #E6E0D3; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>

                            <!-- Print Category -->
                            <VBox spacing="4">
                                <Label text="Print Technology / Category *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <ComboBox fx:id="printCategoryComboBox" maxWidth="Infinity" prefHeight="34"
                                          style="-fx-background-color: white; -fx-border-color: #E6E0D3; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>

                            <!-- Material / Substrate -->
                            <VBox spacing="4">
                                <Label text="Surface / Substrate Material *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <ComboBox fx:id="materialComboBox" maxWidth="Infinity" prefHeight="34"
                                          style="-fx-background-color: white; -fx-border-color: #E6E0D3; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>

                            <!-- Source Type & Designer -->
                            <HBox spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Artwork Source" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                    <ComboBox fx:id="sourceTypeComboBox" maxWidth="Infinity" prefHeight="34"
                                              style="-fx-border-color: #E6E0D3; -fx-border-radius: 8;"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Assigned Designer" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                    <ComboBox fx:id="designerComboBox" maxWidth="Infinity" prefHeight="34"
                                              style="-fx-border-color: #E6E0D3; -fx-border-radius: 8;"/>
                                </VBox>
                            </HBox>

                            <!-- File Attachment -->
                            <VBox spacing="4">
                                <Label text="Artwork / Model File (PNG, JPG, PDF, SVG, STL)" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <HBox spacing="8">
                                    <TextField fx:id="filePathField" promptText="Select design file..." prefHeight="34" HBox.hgrow="ALWAYS"
                                               style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                                    <Button text="📁  Browse" onAction="#handleBrowseFile" prefHeight="34" prefWidth="90"
                                            style="-fx-background-color: #14161F; -fx-text-fill: white; -fx-font-weight: 600; -fx-background-radius: 6; -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>

                            <!-- Status -->
                            <VBox spacing="4">
                                <Label text="Design Status *" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <ComboBox fx:id="statusComboBox" maxWidth="Infinity" prefHeight="34"
                                          style="-fx-background-color: white; -fx-border-color: #E6E0D3; -fx-border-radius: 8; -fx-background-radius: 8;"/>
                            </VBox>

                            <!-- Design Notes -->
                            <VBox spacing="4">
                                <Label text="Dimensions &amp; Design Notes" style="-fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #15171F;"/>
                                <TextArea fx:id="notesArea" promptText="Dimensions (e.g. 10x15cm), color palette, layer thickness..." prefRowCount="3" wrapText="true"
                                          style="-fx-border-color: #E6E0D3; -fx-border-radius: 8;"/>
                            </VBox>

                            <!-- Action Buttons Row 1: Save & Update -->
                            <HBox spacing="10">
                                <Button fx:id="saveButton" text="💾  Save Design"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="38"
                                        onAction="#handleSaveDesign"
                                        style="-fx-background-color: #07768F; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand;"/>

                                <Button fx:id="updateButton" text="✏️  Update" disable="true"
                                        prefWidth="100" prefHeight="38"
                                        onAction="#handleUpdateDesign"
                                        style="-fx-background-color: #FFE600; -fx-text-fill: #15171F; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            </HBox>

                            <!-- Action Buttons Row 2: Quick Approve & Clear -->
                            <HBox spacing="10">
                                <Button fx:id="approveButton" text="✔  Mark Approved" disable="true"
                                        HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="34"
                                        onAction="#handleApproveDesign"
                                        style="-fx-background-color: #1A7A46; -fx-text-fill: white; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand;"/>

                                <Button fx:id="clearButton" text="🔄  Clear"
                                        prefWidth="100" prefHeight="34"
                                        onAction="#handleClear"
                                        style="-fx-background-color: #EBE7DF; -fx-text-fill: #62656F; -fx-font-weight: 600; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            </HBox>

                        </VBox>
                    </ScrollPane>

                    <!-- RIGHT TABLEVIEW CARD -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS"
                          style="
                              -fx-background-color: white;
                              -fx-background-radius: 16;
                              -fx-border-color: #E6E0D3;
                              -fx-border-radius: 16;
                              -fx-border-width: 1;
                              -fx-padding: 20;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 1);">

                        <!-- Table Controls Bar -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Active Designs Directory"
                                       style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #15171F;"/>
                                <Label text="Select a design to view details, update status, or mark approved"
                                       style="-fx-font-size: 12px; -fx-text-fill: #62656F;"/>
                            </VBox>

                            <Label text="Filter:" style="-fx-font-size: 12px; -fx-font-weight: 600;"/>
                            <ComboBox fx:id="filterStatusComboBox" prefWidth="140" prefHeight="34"
                                      style="-fx-border-color: #E6E0D3; -fx-border-radius: 6;"/>
                        </HBox>

                        <Separator style="-fx-padding: 2 0;"/>

                        <!-- Designs TableView -->
                        <TableView fx:id="designTable" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: transparent; -fx-border-color: #E6E0D3; -fx-border-radius: 10;">
                            <columns>
                                <TableColumn fx:id="colCode" text="Design #" prefWidth="90"/>
                                <TableColumn fx:id="colCustomer" text="Customer" prefWidth="140"/>
                                <TableColumn fx:id="colPhone" text="Phone" prefWidth="105"/>
                                <TableColumn fx:id="colCategory" text="Category" prefWidth="110"/>
                                <TableColumn fx:id="colMaterial" text="Material" prefWidth="120"/>
                                <TableColumn fx:id="colSource" text="Source" prefWidth="110"/>
                                <TableColumn fx:id="colDesigner" text="Designer" prefWidth="110"/>
                                <TableColumn fx:id="colStatus" text="Status" prefWidth="95"/>
                                <TableColumn fx:id="colFile" text="File Attached" prefWidth="130"/>
                                <TableColumn fx:id="colDate" text="Date" prefWidth="90"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                    </VBox>

                </HBox>
            </center>

        </BorderPane>
    </center>

</BorderPane>
